From 0f7f7988f3a0cf358ec7aa41e29865bc8f7772ab Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 20 Jun 2026 03:12:29 +0000
Subject: [PATCH] Fix roadmap checkbox visibility: define accent vars and
 improve checked state styling

---
 roadmap.html | 46 +++++++++++++++++++++++++++++++++-------------
 1 file changed, 33 insertions(+), 13 deletions(-)

diff --git a/roadmap.html b/roadmap.html
index b4968c3..7131a91 100644
--- a/roadmap.html
+++ b/roadmap.html
@@ -10,6 +10,20 @@
   <style>
     /* ── Roadmap page styles ────────────────────────────── */
 
+    /* Define accent vars used on this page */
+    :root {
+      --accent-green:  #16a34a;
+      --accent-cyan:   #0891b2;
+      --accent-orange: #ea580c;
+      --accent-purple: #7c3aed;
+    }
+    body.dark-mode {
+      --accent-green:  #2dff7a;
+      --accent-cyan:   #00e5ff;
+      --accent-orange: #ff5c1a;
+      --accent-purple: #8b5cf6;
+    }
+
     /* Progress tracker at top */
     .progress-tracker {
       background: var(--bg-card);
@@ -225,31 +239,37 @@
       color: var(--text-primary);
     }
 
-    .skill-item.checked {
-      color: var(--text-muted);
-      text-decoration: line-through;
-      text-decoration-color: rgba(45,255,122,0.4);
-    }
-
     .skill-checkbox {
-      width: 16px; height: 16px;
-      border-radius: 3px;
-      border: 1.5px solid var(--border-strong);
+      width: 18px; height: 18px;
+      border-radius: 4px;
+      border: 2px solid var(--border-strong);
       flex-shrink: 0;
       display: flex;
       align-items: center;
       justify-content: center;
-      font-size: 0.65rem;
-      font-weight: 700;
-      transition: all var(--transition);
+      font-size: 0.7rem;
+      font-weight: 900;
+      transition: all 0.18s ease;
       color: transparent;
       background: transparent;
     }
 
+    .skill-item:hover .skill-checkbox {
+      border-color: var(--accent-green);
+    }
+
     .skill-item.checked .skill-checkbox {
       background: var(--accent-green);
       border-color: var(--accent-green);
-      color: var(--bg-void);
+      color: #fff;
+      box-shadow: 0 0 0 3px rgba(45,255,122,0.18);
+    }
+
+    .skill-item.checked {
+      color: var(--text-muted);
+      text-decoration: line-through;
+      text-decoration-color: var(--accent-green);
+      opacity: 0.75;
     }
 
     .skill-card-footer {
-- 
2.43.0

