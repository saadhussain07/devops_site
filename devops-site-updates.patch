+  <meta property="og:description" content="Contact Muhammad Saad Hussain — DevOps Engineer &amp; AIOps Researcher. Reach out on LinkedIn, GitHub, or by email.">
+  <meta property="og:type" content="website">
+  <meta property="og:url" content="https://rocketdevops.vercel.app/contact.html">
+  <meta property="og:site_name" content="DevOps Hub">
+  <meta property="og:image" content="https://rocketdevops.vercel.app/og-image.png">
+  <meta property="og:image:width" content="1200">
