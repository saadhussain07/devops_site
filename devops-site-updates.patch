@@ -0,0 +1,994 @@
+<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <meta name="description" content="Hands-on DevOps projects from beginner to advanced — Docker, CI/CD, Kubernetes, Terraform on AWS, GitOps and monitoring. Step-by-step guides with starter code and portfolio tips.">
+  <meta name="keywords" content="DevOps projects, DevOps portfolio, DevOps labs, Kubernetes project, Terraform AWS project, CI/CD project, GitOps project">
+  <meta name="author" content="DevOps Hub">
+  <meta name="robots" content="index, follow">
+  <title>DevOps Projects &amp; Hands-On Labs · DevOps Hub</title>
+  <link rel="icon" href="favicon.svg" type="image/svg+xml">
+  <link rel="stylesheet" href="style.css">
+  <style>
+    /* ── Projects page ───────────────────────────────────── */
+    .pj-intro {
+      display: grid;
+      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
+      gap: 1rem;
+      margin-bottom: 2.5rem;
+    }
+    .pj-intro-card {
+      background: var(--bg-card);
+      border: 1px solid var(--border);
+      border-radius: var(--radius-lg);
+      padding: 1.1rem 1.25rem;
+    }
+    .pj-intro-card strong {
+      display: block;
+      font-family: var(--font-mono);
+      font-size: 0.75rem;
+      letter-spacing: 0.08em;
+      text-transform: uppercase;
+      color: var(--accent-green);
+      margin-bottom: 0.35rem;
+    }
+    .pj-intro-card p { font-size: 0.88rem; margin: 0; }
+
+    .pj-toolbar {
+      display: flex;
+      align-items: center;
+      justify-content: space-between;
+      flex-wrap: wrap;
+      gap: 1rem;
+      margin-bottom: 1.5rem;
+    }
+    .pj-filters { display: flex; flex-wrap: wrap; gap: 0.5rem; }
+    .pj-chip {
+      font-family: var(--font-mono);
+      font-size: 0.72rem;
+      letter-spacing: 0.06em;
+      text-transform: uppercase;
+      padding: 0.45rem 0.9rem;
+      border-radius: 999px;
+      border: 1px solid var(--border);
+      background: var(--bg-card);
+      color: var(--text-secondary);
+      cursor: pointer;
+      transition: all var(--transition);
+    }
+    .pj-chip:hover { border-color: var(--accent-green); color: var(--accent-green); }
+    .pj-chip.active { background: var(--primary); border-color: var(--primary); color: #fff; }
+
+    .pj-progress {
+      font-family: var(--font-mono);
+      font-size: 0.78rem;
+      color: var(--text-secondary);
+      display: flex;
+      align-items: center;
+      gap: 0.75rem;
+    }
+    .pj-progress-bar {
+      width: 140px;
+      height: 6px;
+      background: var(--bg-surface);
+      border: 1px solid var(--border);
+      border-radius: 999px;
+      overflow: hidden;
+    }
+    .pj-progress-fill {
+      height: 100%;
+      width: 0;
+      background: linear-gradient(90deg, var(--primary), var(--primary-light));
+      transition: width var(--transition-slow);
+    }
+
+    .pj-list { display: flex; flex-direction: column; gap: 1.25rem; }
+
+    .pj-card {
+      background: var(--bg-card);
+      border: 1px solid var(--border);
+      border-radius: var(--radius-lg);
+      overflow: hidden;
+      scroll-margin-top: 80px;
+      transition: border-color var(--transition);
+    }
+    .pj-card:hover { border-color: var(--border-strong); }
+    .pj-card.done { border-color: var(--accent-green); }
+
+    .pj-head {
+      display: grid;
+      grid-template-columns: auto 1fr auto;
+      gap: 1rem;
+      align-items: start;
+      padding: 1.4rem 1.5rem 1.1rem;
+    }
+    .pj-num {
+      width: 44px; height: 44px;
+      border-radius: var(--radius);
+      border: 1px solid var(--border);
+      background: var(--bg-surface);
+      display: flex; align-items: center; justify-content: center;
+      font-family: var(--font-mono);
+      font-weight: 700;
+      color: var(--accent-green);
+    }
+    .pj-head h2 { font-size: 1.2rem; margin-bottom: 0.35rem; }
+    .pj-head p  { font-size: 0.9rem; margin: 0; }
+    .pj-meta { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: 0.75rem; }
+    .pj-pill {
+      font-family: var(--font-mono);
+      font-size: 0.65rem;
+      letter-spacing: 0.05em;
+      padding: 0.15rem 0.55rem;
+      border-radius: 3px;
+      border: 1px solid var(--border);
+      color: var(--text-muted);
+    }
+    .pj-pill.lvl-beginner     { color: var(--accent-green);  border-color: var(--accent-green); }
+    .pj-pill.lvl-intermediate { color: var(--accent-cyan);   border-color: var(--accent-cyan); }
+    .pj-pill.lvl-advanced     { color: var(--accent-orange); border-color: var(--accent-orange); }
+
+    .pj-done {
+      display: flex;
+      align-items: center;
+      gap: 0.4rem;
+      font-family: var(--font-mono);
+      font-size: 0.7rem;
+      color: var(--text-muted);
+      cursor: pointer;
+      white-space: nowrap;
+      user-select: none;
+    }
+    .pj-done input { accent-color: var(--primary); width: 16px; height: 16px; cursor: pointer; }
+
+    .pj-body { border-top: 1px solid var(--border); }
+    .pj-body > details { border-bottom: 1px solid var(--border); }
+    .pj-body > details:last-child { border-bottom: none; }
+    .pj-body summary {
+      cursor: pointer;
+      padding: 0.85rem 1.5rem;
+      font-family: var(--font-mono);
+      font-size: 0.78rem;
+      letter-spacing: 0.06em;
+      text-transform: uppercase;
+      color: var(--text-secondary);
+      list-style: none;
+      display: flex;
+      justify-content: space-between;
+      align-items: center;
