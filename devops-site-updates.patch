+<script>
+'use strict';
+const items  = [...document.querySelectorAll('.qa-item')];
+const groups = [...document.querySelectorAll('.qa-group')];
+const search = document.getElementById('qa-search');
+const count  = document.getElementById('qa-count');
+let cat = 'all', lvl = 'all';
+
+function apply() {
+  const q = search.value.toLowerCase().trim();
+  let shown = 0;
+  items.forEach(it => {
+    const ok = (cat === 'all' || it.dataset.cat === cat) &&
+               (lvl === 'all' || it.dataset.lvl === lvl) &&
+               (!q || it.textContent.toLowerCase().includes(q));
+    it.style.display = ok ? '' : 'none';
+    if (ok) shown++;
+    if (q && ok) it.open = true;
+  });
+  groups.forEach(g => {
+    g.style.display = [...g.querySelectorAll('.qa-item')].some(i => i.style.display !== 'none') ? '' : 'none';
+  });
+  count.textContent = `${shown} of ${items.length} shown`;
+  document.getElementById('qa-empty').style.display = shown ? 'none' : 'block';
+}
+
+document.querySelectorAll('[data-filter-cat]').forEach(ch => ch.addEventListener('click', () => {
+  document.querySelectorAll('[data-filter-cat]').forEach(c => c.classList.remove('active'));
+  ch.classList.add('active'); cat = ch.dataset.filterCat; apply();
+}));
+document.querySelectorAll('[data-filter-lvl]').forEach(ch => ch.addEventListener('click', () => {
+  document.querySelectorAll('[data-filter-lvl]').forEach(c => c.classList.remove('active'));
+  ch.classList.add('active'); lvl = ch.dataset.filterLvl; apply();
+}));
+search.addEventListener('input', apply);
+
+document.getElementById('qa-expand')?.addEventListener('click', e => {
+  const open = e.target.dataset.open !== '1';
+  items.forEach(i => { if (i.style.display !== 'none') i.open = open; });
+  e.target.dataset.open = open ? '1' : '0';
+  e.target.textContent = open ? '⊟ Collapse all' : '⊞ Expand all';
+});
+
+function openFromHash() {
+  const t = location.hash && document.getElementById(decodeURIComponent(location.hash.slice(1)));
+  if (t && t.tagName === 'DETAILS') { t.open = true; t.scrollIntoView({ block: 'start' }); }
+}
+window.addEventListener('hashchange', openFromHash);
+apply();
+openFromHash();
+</script>
