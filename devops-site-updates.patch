+'use strict';
+
+/* ── Progress (saved per browser) ────────────────────────── */
+const STORE_KEY = 'dh-projects-done';
+const boxes = document.querySelectorAll('.pj-done input');
+
+function loadDone() {
+  try { return JSON.parse(localStorage.getItem(STORE_KEY)) || []; } catch { return []; }
+}
+function saveDone(list) {
+  try { localStorage.setItem(STORE_KEY, JSON.stringify(list)); } catch { /* storage unavailable */ }
+}
+function renderProgress() {
+  const done = [...boxes].filter(b => b.checked).length;
+  document.getElementById('pj-count').textContent = `${done} / ${boxes.length} completed`;
+  document.getElementById('pj-fill').style.width = `${(done / boxes.length) * 100}%`;
+  boxes.forEach(b => b.closest('.pj-card').classList.toggle('done', b.checked));
+}
+
+const saved = loadDone();
+boxes.forEach(b => {
+  b.checked = saved.includes(b.dataset.project);
+  b.addEventListener('change', () => {
+    saveDone([...boxes].filter(x => x.checked).map(x => x.dataset.project));
+    renderProgress();
+  });
+});
+renderProgress();
+
+/* ── Level filter ────────────────────────────────────────── */
+document.querySelectorAll('.pj-chip').forEach(chip => {
+  chip.addEventListener('click', () => {
+    document.querySelectorAll('.pj-chip').forEach(c => c.classList.remove('active'));
+    chip.classList.add('active');
+    const lvl = chip.dataset.level;
+    document.querySelectorAll('.pj-card').forEach(card => {
+      card.style.display = (lvl === 'all' || card.dataset.level === lvl) ? '' : 'none';
+    });
+  });
+});
+
+/* ── Open the linked project when arriving via #hash ─────── */
+if (location.hash) {
+  const target = document.querySelector(location.hash);
+  if (target && target.classList.contains('pj-card')) {
+    target.querySelectorAll('details').forEach(d => d.open = true);
+  }
+}
+
+/* ── Copy buttons on code blocks ─────────────────────────── */
+document.querySelectorAll('.pj-section pre').forEach(pre => {
+  const btn = document.createElement('button');
+  btn.className = 'pj-copy';
+  btn.type = 'button';
+  btn.textContent = 'copy';
+  btn.addEventListener('click', async () => {
+    try {
+      await navigator.clipboard.writeText(pre.querySelector('code').textContent);
+      btn.textContent = '✓ copied';
+    } catch { btn.textContent = '✗'; }
+    setTimeout(() => btn.textContent = 'copy', 1600);
+  });
+  pre.appendChild(btn);
+});
+</script>
