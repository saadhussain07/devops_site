+<script>
+'use strict';
+/* ── Start Here path tabs (choice remembered per browser) ── */
+(function initPaths() {
+  const tabs = document.querySelectorAll('.sh-tab');
+  const panels = document.querySelectorAll('.sh-panel');
+  function show(path) {
+    tabs.forEach(t => {
+      const on = t.dataset.path === path;
+      t.classList.toggle('active', on);
+      t.setAttribute('aria-selected', on ? 'true' : 'false');
+    });
+    panels.forEach(p => { p.hidden = p.dataset.path !== path; });
+  }
+  let saved = null;
+  try { saved = localStorage.getItem('dh-path'); } catch { /* storage unavailable */ }
+  if (saved && document.querySelector(`.sh-tab[data-path="${saved}"]`)) show(saved);
+  tabs.forEach(t => t.addEventListener('click', () => {
+    show(t.dataset.path);
+    try { localStorage.setItem('dh-path', t.dataset.path); } catch { /* storage unavailable */ }
+  }));
+})();
+</script>
