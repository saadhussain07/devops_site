+function drawCertificate(name) {
+  const c = document.getElementById('cert-canvas');
+  const x = c.getContext('2d');
+  const W = c.width, H = c.height;
+
+  x.fillStyle = '#0b1416';
+  x.fillRect(0, 0, W, H);
+  x.strokeStyle = 'rgba(20,184,166,0.10)';
+  x.lineWidth = 1;
+  for (let i = 0; i < W; i += 40) { x.beginPath(); x.moveTo(i, 0); x.lineTo(i, H); x.stroke(); }
+  for (let j = 0; j < H; j += 40) { x.beginPath(); x.moveTo(0, j); x.lineTo(W, j); x.stroke(); }
+  x.strokeStyle = '#14b8a6';
+  x.lineWidth = 6;
+  x.strokeRect(40, 40, W - 80, H - 80);
+  x.lineWidth = 1.5;
+  x.strokeRect(60, 60, W - 120, H - 120);
+
+  x.textAlign = 'center';
+  x.fillStyle = '#14b8a6';
+  x.font = 'bold 40px "Courier New", monospace';
+  x.fillText('> DevOpsHub', W / 2, 170);
+
+  x.fillStyle = '#9ca3af';
+  x.font = '28px "Courier New", monospace';
+  x.fillText('CERTIFICATE OF ACHIEVEMENT', W / 2, 250);
+
+  x.fillStyle = '#d1d5db';
+  x.font = 'italic 32px Georgia, serif';
+  x.fillText('This certifies that', W / 2, 360);
+
+  x.fillStyle = '#ffffff';
+  x.font = 'bold 76px Georgia, serif';
+  x.fillText(name, W / 2, 470, W - 240);
+  x.strokeStyle = '#14b8a6';
+  x.lineWidth = 2;
+  x.beginPath(); x.moveTo(W / 2 - 420, 500); x.lineTo(W / 2 + 420, 500); x.stroke();
+
+  x.fillStyle = '#d1d5db';
+  x.font = '32px Georgia, serif';
+  x.fillText('passed the DevOps Hub knowledge quiz', W / 2, 580);
+  x.fillText(`Topic: ${lastResult.topic}`, W / 2, 630);
+
+  x.fillStyle = '#2dff7a';
+  x.font = 'bold 64px "Courier New", monospace';
+  x.fillText(`${lastResult.pct}%  ·  ${lastResult.correct}/${lastResult.total}`, W / 2, 750);
+
+  x.fillStyle = '#9ca3af';
+  x.font = '26px "Courier New", monospace';
